{
  "name": "sprite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "worker:dev": "npm run build && wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply sprite --local",
    "db:migrate:remote": "wrangler d1 migrations apply sprite --remote",
    "cf:check": "wrangler check",
    "deploy": "npm run build && wrangler deploy",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260617.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "wrangler": "^4.101.0"
  },
  "dependencies": {
    "lucide-react": "^1.20.0"
  }
}
